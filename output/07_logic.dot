digraph logic {
  rankdir=TB;
  node [fontname="Helvetica"];
  START [shape=Mdiamond, style=filled, fillcolor="#e8f5e9"];
  STOP  [shape=Msquare,  style=filled, fillcolor="#ffebee"];
  B1 [shape=diamond, style="filled,rounded", fillcolor="#fff8e1", label="B1\nboolean flag = a > 0 && b < 10;\nflag"];
  B2 [shape=box, style="filled,rounded", fillcolor="#e3f2fd", label="B2\nwrite(a);"];
  B3 [shape=diamond, style="filled,rounded", fillcolor="#fff8e1", label="B3\na > 0 || b > 0"];
  B4 [shape=box, style="filled,rounded", fillcolor="#e3f2fd", label="B4\nwrite(b);"];
  START -> B1;
  B1 -> B2 [label="true", color="#2e7d32"];
  B1 -> B3 [label="false", color="#c62828"];
  B2 -> B3;
  B3 -> B4 [label="true", color="#2e7d32"];
  B3 -> STOP [label="false", color="#c62828"];
  B4 -> STOP;
}
