digraph extras {
  rankdir=TB;
  node [fontname="Helvetica"];
  START [shape=Mdiamond, style=filled, fillcolor="#e8f5e9"];
  STOP  [shape=Msquare,  style=filled, fillcolor="#ffebee"];
  B1 [shape=diamond, style="filled,rounded", fillcolor="#fff8e1", label="B1\nint x = 0;\nn > 0"];
  B2 [shape=box, style="filled,rounded", fillcolor="#e3f2fd", label="B2\nx = n;"];
  B3 [shape=box, style="filled,rounded", fillcolor="#e3f2fd", label="B3\nx = -n;"];
  B4 [shape=box, style="filled,rounded", fillcolor="#e3f2fd", label="B4\nx++;\n--x;\nfoo(x);\nbar(x + 1, n);"];
  B5 [shape=diamond, style="filled,rounded", fillcolor="#fff8e1", label="B5\nfor (int v : arr)"];
  B6 [shape=box, style="filled,rounded", fillcolor="#e3f2fd", label="B6\nwrite(v);"];
  START -> B1;
  B1 -> B2 [label="true", color="#2e7d32"];
  B1 -> B3 [label="false", color="#c62828"];
  B2 -> B4;
  B3 -> B4;
  B4 -> B5;
  B5 -> B6 [label="true", color="#2e7d32"];
  B5 -> STOP [label="false", color="#c62828"];
  B6 -> B5;
}
